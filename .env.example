# ==============================================================================
# ASTROSENSE - Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the server if custom configuration is needed.

# API Server Port
PORT=3001

# Environment Mode
NODE_ENV=development

# Path to local JSON / SQLite storage directory
DATA_DIR=./data

# Delay-Tolerant Re-Synchronization policy
AUTO_SYNC_ON_RESTORE=true

# Autonomous Inactivity Timeout threshold (seconds)
DEFAULT_INACTIVITY_THRESHOLD_SECONDS=900

# Edge AI Anomaly Sensitivity (LOW | MEDIUM | HIGH)
DEFAULT_ANOMALY_SENSITIVITY=MEDIUM
