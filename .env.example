# ==============================================================================
# ASTROSENSE — Environment Configuration Template
# ==============================================================================
# Copy this file to .env or configure variables in your Render deployment dashboard.
# NEVER commit actual passwords or sensitive credentials to source control.
# ==============================================================================

# Backend API Configuration
PORT=3001
NODE_ENV=development

# Allowed Frontend Origin for CORS (e.g., https://astrosense-client.onrender.com or comma-separated)
FRONTEND_URL=http://localhost:3000

# Ground PostgreSQL Database URL (Leave blank for autonomous onboard SQLite mode)
DATABASE_URL=
DATABASE_SSL=true
DATABASE_AUTO_SYNC=true
DATABASE_SYNC_INTERVAL_MS=10000

# Frontend API Base URL (Configured in Client environment / Render Static Site)
VITE_API_BASE_URL=http://localhost:3001
