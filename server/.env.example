# ==============================================================================
# ASTROSENSE Server — Environment Variables (Render Web Service / Local Backend)
# ==============================================================================

# Server Network Configuration
PORT=3001
NODE_ENV=development

# Frontend Origins Allowed by CORS (e.g. https://astrosense-client.onrender.com)
FRONTEND_URL=http://localhost:3000

# Ground Database Connection (PostgreSQL on Render, Neon, Supabase, Railway)
DATABASE_URL=
DATABASE_SSL=true
DATABASE_AUTO_SYNC=true
DATABASE_SYNC_INTERVAL_MS=10000
